<Project Sdk="Microsoft.NET.Sdk">
  <!-- The MelonLoader entry point for every LibriaMods mod (goes to the game's Mods folder).
       Game-agnostic: game mods install it together with LibriaMods.Unity.Shared. -->
  <PropertyGroup>
    <Version>1.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LibriaMods.Unity.Shared\LibriaMods.Unity.Shared.csproj" Private="false" />
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.3" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
